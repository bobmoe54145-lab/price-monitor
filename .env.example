# --- 楽天ウェブサービス ---
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
# アプリ登録の「許可されたWebサイト」に入れたドメイン（例: https://yourname.github.io）
RAKUTEN_ORIGIN=
# 通常は変更不要
# RAKUTEN_API_VERSION=20260701

# --- Google スプレッドシート ---
# スプレッドシートの ID（URL の /d/ と /edit の間）。URL 全体でも可
SPREADSHEET_ID=
# ローカル実行: サービスアカウントの JSON キーファイルのパス
GOOGLE_APPLICATION_CREDENTIALS=
# GitHub Actions 等: JSON の中身をそのまま入れる（ローカルでは上のパスを使う）
# GOOGLE_SERVICE_ACCOUNT_JSON=
